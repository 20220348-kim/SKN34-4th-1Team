# iOS simulator: http://localhost:8080
# Android emulator: http://10.0.2.2:8080
# Physical device: the development computer's LAN IP, e.g. http://192.168.0.10:8080
# Production: HTTPS public API origin (the Vercel origin can serve /api).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# Enable only after a native build and the backend mobile OAuth redirect allowlist are configured.
EXPO_PUBLIC_ENABLE_SOCIAL_LOGIN=false
