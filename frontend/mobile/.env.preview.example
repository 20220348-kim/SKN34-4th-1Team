# 발표용 EAS preview 환경에 등록할 값의 목록입니다. 실제 값은 커밋하지 않습니다.
# 이 파일은 Expo가 자동으로 읽지 않습니다. .env.local 개발 설정을 덮어쓰지 마세요.
# 상세 등록·빌드·Firebase 배포 순서: ../../docs/mobile-app-distribution.md

# 필수: 휴대폰에서 접근 가능한 HTTPS API origin. 끝에 /api 또는 다른 경로를 넣지 않습니다.
# 기존 Vercel 운영 주소를 사용한다면 서버 /api 연결이 준비된 뒤 지정합니다.
EXPO_PUBLIC_API_BASE_URL=

# 필수: 로그인한 Expo 계정/조직의 실제 프로젝트 UUID. Firebase App ID와 다릅니다.
EXPO_PUBLIC_EAS_PROJECT_ID=

# 선택: 협업 모집글 공유 링크의 HTTPS 웹 origin. 공유 링크를 제공할 때 설정합니다.
EXPO_PUBLIC_WEB_BASE_URL=

# 선택: 실제 서버·OAuth 공급자·앱 복귀 주소 설정을 완료한 경우에만 true로 변경합니다.
EXPO_PUBLIC_ENABLE_SOCIAL_LOGIN=false

# 선택: 로그인 회원 도우미의 자유 질문 제공 여부. AI 검색 전체를 끄는 설정이 아닙니다.
EXPO_PUBLIC_ASSISTANT_AI_ENABLED=false

# 푸시 제공 시: EAS에서는 String 경로 대신 File 환경변수로 Android 설정 JSON을 등록합니다.
# 로컬 설정은 GOOGLE_SERVICES_JSON=./google-services.json으로 지정할 수 있습니다.
# FCM v1 서비스 계정 키는 이 변수에 넣지 않고 Expo Push Credentials에 등록합니다.
GOOGLE_SERVICES_JSON=
