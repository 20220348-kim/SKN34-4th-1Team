{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["component", "replicas", "image", "allowLocalImages", "evidenceImage", "imagePullSecrets", "storage", "runner", "resources"],
  "properties": {
    "component": {"enum": ["prefect", "evaluation-runner", "ops-artifacts"]},
    "replicas": {"type": "integer", "minimum": 0, "maximum": 1},
    "image": {"type": "string", "minLength": 1},
    "allowLocalImages": {"type": "boolean"},
    "evidenceImage": {"type": "string"},
    "imagePullSecrets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253}},
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["existingClaim", "node"],
      "properties": {
        "existingClaim": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "node": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}
      }
    },
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": ["opsApiUrl", "langfuseUrl"],
      "properties": {"opsApiUrl": {"type": "string"}, "langfuseUrl": {"type": "string"}}
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourcePair"},
        "limits": {"$ref": "#/definitions/resourcePair"}
      }
    }
  },
  "definitions": {
    "resourcePair": {
      "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": ["string", "number"], "pattern": "^[0-9]+(\\.[0-9]+)?m?$", "exclusiveMinimum": 0},
        "memory": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}
      }
    }
  }
}
