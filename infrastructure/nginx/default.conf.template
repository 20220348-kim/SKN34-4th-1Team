map_hash_bucket_size 128;
map $http_x_govbiz_proxy_secret $govbiz_proxy_allowed {
    default 0;
    "${GOVBIZ_PROXY_SECRET}" 1;
}

# 쿼리(검색어/OAuth code)·쿠키·비밀 헤더를 접근 로그에 기록하지 않는다.
log_format govbiz '$request_method $uri $status $request_time';

server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log govbiz;
    error_log /var/log/nginx/error.log crit;
    # 대화 snapshot 2,000,000 bytes와 요청 JSON wrapper를 보존한다.
    client_max_body_size 2m;
    client_header_timeout 10s;
    client_body_timeout 15s;

    add_header Cache-Control "private, no-store" always;
    add_header CDN-Cache-Control "no-store" always;
    add_header Vercel-CDN-Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;

    location = /nginx-health {
        if ($remote_addr != 127.0.0.1) { return 404; }
        access_log off;
        return 204;
    }

    location /api/ {
        # Vercel 공유 비밀값이 없는 CloudFront 직접 접근·위조 IP 요청은 거부한다.
        if ($govbiz_proxy_allowed = 0) { return 403; }
        if ($http_x_govbiz_client_ip = "") { return 400; }
        # Core 재생성 이후 주소도 Docker DNS로 다시 확인한다.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $core_upstream http://core-service:8080;
        proxy_pass $core_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host core-service;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For $http_x_govbiz_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Govbiz-Proxy-Secret "";
        proxy_set_header X-Govbiz-Client-IP "";
        proxy_connect_timeout 3s;
        proxy_send_timeout 100s;
        proxy_read_timeout 100s;
        proxy_next_upstream off;
        proxy_cache off;
        proxy_hide_header Cache-Control;
        proxy_hide_header CDN-Cache-Control;
        proxy_hide_header Vercel-CDN-Cache-Control;
        proxy_hide_header Expires;

        # A cold document request runs mapping and generation sequentially.
        # Rewrite-phase checks/set are explicit; proxy headers inherit from above.
        location ~ ^/api/v1/application-preparations/[0-9]+/documents$ {
            if ($govbiz_proxy_allowed = 0) { return 403; }
            if ($http_x_govbiz_client_ip = "") { return 400; }
            set $core_upstream http://core-service:8080;
            proxy_pass $core_upstream$request_uri;
            proxy_read_timeout 600s;
        }
    }

    location / { return 404; }
}
