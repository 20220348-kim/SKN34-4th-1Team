# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PREFECT_HOME=/tmp/prefect DO_NOT_TRACK=1
WORKDIR /app/backend/ai-service
COPY backend/ai-service/pyproject.toml backend/ai-service/uv.lock ./
RUN uv sync --locked --no-dev --group evaluation --no-install-project
# RAG 사전 검증과 임베딩 배치는 실행 중 외부 토크나이저 다운로드를 요구하지 않는다.
ENV TIKTOKEN_CACHE_DIR=/app/tokenizer-cache
RUN .venv/bin/python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"
COPY backend/ai-service/app ./app
COPY evaluation/support-program-evidence /app/evaluation/support-program-evidence
COPY backend/ops-service/apps/evaluations/catalog.py backend/ops-service/apps/evaluations/capture_catalog.json backend/ops-service/apps/evaluations/rag_live_plans.json /app/backend/ops-service/apps/evaluations/
COPY backend/ops-service/apps/evaluations/recovery_inputs.py /app/backend/ops-service/apps/evaluations/
COPY backend/ops-service/apps/evaluations/execution_spec.py backend/ops-service/apps/evaluations/execution_release.json /app/backend/ops-service/apps/evaluations/
COPY backend/ops-service/apps/evaluations/quality_policy.py /app/backend/ops-service/apps/evaluations/
COPY backend/ops-service/apps/evaluations/rag_replay.py /app/backend/ops-service/apps/evaluations/
COPY backend/ops-service/apps/evaluations/vector_cache.py backend/ops-service/apps/evaluations/artifact_files.py /app/backend/ops-service/apps/evaluations/
RUN .venv/bin/python /app/backend/ops-service/apps/evaluations/execution_spec.py
RUN groupadd --gid 10001 govbiz \
    && useradd --uid 10001 --gid govbiz --no-create-home govbiz \
    && mkdir -p /results /app/work/llmops \
    && chown -R govbiz:govbiz /results /app/work
USER 10001:10001
# 빈 캐시/권한 회귀는 긴 통합 실행 전에 빌드에서 거절한다. 모델 API 호출은 없다.
RUN --network=none .venv/bin/python - <<'PY'
from app.support_program_embedding import prepare_embedding_batches

texts = ["지원사업 신청 자격과 제출 서류", "지원사업 신청 자격과 제출 서류"]
batches = prepare_embedding_batches(texts)
assert len(batches) == 1 and batches[0][0] == texts and batches[0][1] > 0
print("Offline embedding preparation verified as runtime user; model calls: 0")
PY
CMD [".venv/bin/python", "/app/evaluation/support-program-evidence/ops_flow.py"]
