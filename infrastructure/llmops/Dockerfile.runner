# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PREFECT_HOME=/tmp/prefect DO_NOT_TRACK=1
WORKDIR /app/backend/ai-service
COPY backend/ai-service/pyproject.toml backend/ai-service/uv.lock ./
RUN uv sync --locked --no-dev --group evaluation --no-install-project
COPY backend/ai-service/app ./app
COPY evaluation/support-program-evidence /app/evaluation/support-program-evidence
COPY backend/ops-service/apps/evaluations/catalog.py backend/ops-service/apps/evaluations/capture_catalog.json /app/backend/ops-service/apps/evaluations/
RUN groupadd --gid 10001 govbiz \
    && useradd --uid 10001 --gid govbiz --no-create-home govbiz \
    && mkdir -p /results /app/work/llmops \
    && chown -R govbiz:govbiz /results /app/work
USER 10001:10001
CMD [".venv/bin/python", "/app/evaluation/support-program-evidence/ops_flow.py"]
