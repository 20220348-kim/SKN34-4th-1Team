# 이 파일은 값 안내용이다. 실제 값은 EC2의 /opt/govbiz/.env.production 등에 보관(chmod 600).
# 개발용 .env와 혼용하지 않는다. secret은 각각 독립적으로 openssl rand -hex 32로 생성한다.
AWS_REGION=ap-southeast-2
GOVBIZ_FRONTEND_ORIGIN=https://REPLACE_WITH_VERCEL_PROJECT.vercel.app
EC2_PRIVATE_IP=
# AWS CPU 아키텍처로 빌드하여 ECR에 올린 commit tag 또는 sha256 digest (latest 금지).
CORE_API_IMAGE=
AI_SERVICE_IMAGE=
ELASTICSEARCH_IMAGE=
# 공식 nginx alpine의 검토한 고정 버전/digest. mutable alpine/latest 사용 금지.
NGINX_IMAGE=nginx@sha256:dc5069ad14f19660b141b21236140b91656bf89bbc3e2417c70ae650cd66104c
GOVBIZ_PROXY_SECRET=
RDS_HOST=
MYSQL_DATABASE=govbiz
MYSQL_USER=govbiz
MYSQL_PASSWORD=
# 공개 RDS CA만 포함한 PKCS12 파일. 파일 비밀번호 changeit은 비밀정보가 아니다.
RDS_TRUSTSTORE_PATH=/opt/govbiz/certs/rds-truststore.p12
ACCOUNT_JWT_SECRET=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
QDRANT_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_RANKING_MODEL=
# 도우미 활성화는 유료 LLM 호출을 허용한다. 공유 토큰은 32자 이상, EC2에만 보관한다.
# Vercel Production에는 VITE_ASSISTANT_AI_ENABLED=true와 VITE_KAKAO_CHANNEL_ID를 별도로 설정한다.
ASSISTANT_AGENT_ENABLED=false
ASSISTANT_TOOLS_TOKEN=
# 문서 분석·생성 내부 인증용. Core/AI에 동일한 32자 이상 비밀값을 전달하며 Vercel에는 넣지 않는다.
DOCUMENT_INTERNAL_TOKEN=
# 아래는 비용·API 권한 확인 후 필요한 제공처만 켠다.
BIZINFO_SYNC_ENABLED=false
KSTARTUP_SYNC_ENABLED=false
MSIT_SYNC_ENABLED=false
CNTRADE_NOTICE_SYNC_ENABLED=false
SUPPORT_PROGRAM_INDEX_ENABLED=false
DAILY_REPORT_QUEUE_ENABLED=false
DAILY_REPORT_DELIVERY_QUEUE_ENABLED=false
COMBINATION_REVIEW_QUEUE_ENABLED=false
APPLICATION_FORM_DISCOVERY_QUEUE_ENABLED=false
ACCOUNT_OAUTH_UNLINK_QUEUE_ENABLED=false
ACCOUNT_OAUTH_UNLINK_ENABLED=false
DATA_GO_KR_SERVICE_KEY=
KSTARTUP_API_KEY=
MSIT_API_KEY=
CNTRADE_NOTICE_API_KEY=
BIZNO_API_KEY=
ACCOUNT_OAUTH_GOOGLE_CLIENT_ID=
# 네이티브 빌드의 앱 복귀 주소를 허용할 때만 govbiz://oauth/complete를 지정합니다.
ACCOUNT_MOBILE_OAUTH_REDIRECT_URIS=
ACCOUNT_OAUTH_GOOGLE_CLIENT_SECRET=
ACCOUNT_OAUTH_KAKAO_CLIENT_ID=
ACCOUNT_OAUTH_KAKAO_CLIENT_SECRET=
ACCOUNT_OAUTH_KAKAO_ADMIN_KEY=
# 계정 인증/비밀번호 재설정 메일만 제어한다. 정기 리포트 메일과 별개다.
# 실제 자격증명을 채운 뒤 필요한 스위치를 true로 변경한다.
ACCOUNT_EMAIL_VERIFICATION_MAIL_ENABLED=false
ACCOUNT_EMAIL_VERIFICATION_FROM=
ACCOUNT_PASSWORD_RESET_MAIL_ENABLED=false
ACCOUNT_PASSWORD_RESET_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false
