# CloudFront's dedicated hostname serves Langfuse at / and adds /_langfuse
# only on the private origin hop. Its viewer function validates access and
# replaces the marker and host; neither the browser nor another origin can
# authorize this route without the independent origin secret.
location = /_langfuse {
    absolute_redirect off;
    if ($http_x_govbiz_langfuse_origin != "${GOVBIZ_LANGFUSE_PROXY_SECRET}") { return 403; }
    if ($http_x_govbiz_langfuse_access != "allowed") { return 403; }
    if ($http_x_govbiz_langfuse_host !~ "^d[a-z0-9]+\.cloudfront\.net$") { return 403; }
    return 308 /;
}
location ^~ /_langfuse/ {
    if ($http_x_govbiz_langfuse_origin != "${GOVBIZ_LANGFUSE_PROXY_SECRET}") { return 403; }
    if ($http_x_govbiz_langfuse_access != "allowed") { return 403; }
    if ($http_x_govbiz_langfuse_host !~ "^d[a-z0-9]+\.cloudfront\.net$") { return 403; }
    if ($govbiz_langfuse_uri = "") { return 400; }
    set $govbiz_langfuse langfuse-web.govbiz-observability.svc.cluster.local:3000;
    proxy_pass http://$govbiz_langfuse$govbiz_langfuse_uri;
    proxy_http_version 1.1;
    proxy_pass_request_headers off;
    proxy_set_header Host $http_x_govbiz_langfuse_host;
    proxy_set_header X-Forwarded-Host $http_x_govbiz_langfuse_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_set_header Accept $http_accept;
    proxy_set_header Accept-Language $http_accept_language;
    proxy_set_header Content-Type $http_content_type;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Origin $http_origin;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header RSC $http_rsc;
    proxy_set_header Next-Action $http_next_action;
    proxy_set_header Next-Router-State-Tree $http_next_router_state_tree;
    proxy_set_header Next-Router-Prefetch $http_next_router_prefetch;
    proxy_set_header Next-Url $http_next_url;
    proxy_connect_timeout 3s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    proxy_next_upstream off;
    proxy_buffering off;
    proxy_cache off;
    proxy_redirect off;
    proxy_hide_header Cache-Control;
    proxy_hide_header Expires;
}
