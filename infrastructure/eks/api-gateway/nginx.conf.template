worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr crit;
events { worker_connections 512; }
http {
    default_type application/json;
    # Never record queries, bodies, cookies or credentials.
    log_format govbiz '$request_method $uri $status $request_time';
    access_log /dev/stdout govbiz;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    server_tokens off;
    map_hash_bucket_size 128;
    map $http_x_govbiz_proxy_secret $govbiz_proxy_allowed {
        default 0;
        "${GOVBIZ_PROXY_SECRET}" 1;
    }
    map $uri $govbiz_upstream {
        default core-service.govbiz-msa.svc.cluster.local:8080;
        ~^/api/v1/ops(?:/|$) ops-service.govbiz-msa.svc.cluster.local:8000;
    }
    # Nginx's async resolver does not apply resolv.conf search domains. Use full
    # Service DNS names and re-resolve after recreation; no fixed Pod IPs.
    resolver ${GOVBIZ_DNS_RESOLVER} valid=10s ipv6=off;
    server {
        listen 8080;
        server_name _;
        client_max_body_size 2m;
        client_header_timeout 10s;
        client_body_timeout 15s;
        add_header Cache-Control "private, no-store" always;
        add_header CDN-Cache-Control "no-store" always;
        add_header Vercel-CDN-Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        # ALB and Kubernetes probes; this endpoint never calls an application.
        location = /healthz { access_log off; return 200 '{"status":"ok"}'; }
        location = /api { return 404; }
        include /tmp/argocd.conf;
        location /api/ {
            if ($govbiz_proxy_allowed = 0) { return 403; }
            if ($http_x_govbiz_client_ip = "") { return 400; }
            proxy_pass http://$govbiz_upstream$request_uri;
            proxy_http_version 1.1;
            # Only forward the application contract, never client-supplied proxy headers.
            proxy_pass_request_headers off;
            proxy_set_header Host $proxy_host;
            proxy_set_header Connection "";
            proxy_set_header Accept $http_accept;
            proxy_set_header Accept-Language $http_accept_language;
            proxy_set_header Content-Type $http_content_type;
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Origin $http_origin;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header X-Chat-Account $http_x_chat_account;
            proxy_set_header X-CSRFToken $http_x_csrftoken;
            proxy_set_header X-Forwarded-For $http_x_govbiz_client_ip;
            proxy_set_header X-Forwarded-Proto https;
            proxy_connect_timeout 3s;
            proxy_send_timeout 100s;
            proxy_read_timeout 100s;
            proxy_next_upstream off;
            proxy_buffering off;
            proxy_cache off;
            proxy_hide_header Cache-Control;
            proxy_hide_header CDN-Cache-Control;
            proxy_hide_header Vercel-CDN-Cache-Control;
            proxy_hide_header Expires;
            location ~ ^/api/v1/application-preparations/[0-9]+/documents$ {
                if ($govbiz_proxy_allowed = 0) { return 403; }
                if ($http_x_govbiz_client_ip = "") { return 400; }
                proxy_pass http://$govbiz_upstream$request_uri;
                proxy_read_timeout 600s;
            }
        }
        # No SPA fallback, internal APIs, DB, Langfuse or Prefect exposure.
        location / { return 404; }
    }
}
