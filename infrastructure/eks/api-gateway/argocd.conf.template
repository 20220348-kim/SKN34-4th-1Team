# CloudFront supplies a separate origin secret and a viewer-IP-checked marker.
# Both checks apply to the normalized path, including encoded path variants.
location = /argocd {
    absolute_redirect off;
    if ($http_x_govbiz_argo_origin != "${GOVBIZ_ARGO_PROXY_SECRET}") { return 403; }
    if ($http_x_govbiz_argo_access != "allowed") { return 403; }
    return 308 /argocd/;
}
location /argocd/ {
    if ($http_x_govbiz_argo_origin != "${GOVBIZ_ARGO_PROXY_SECRET}") { return 403; }
    if ($http_x_govbiz_argo_access != "allowed") { return 403; }
    set $govbiz_argocd argocd-server.argocd.svc.cluster.local:8080;
    proxy_pass https://$govbiz_argocd$request_uri;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/govbiz-argocd/tls.crt;
    proxy_ssl_server_name on;
    proxy_ssl_name argocd-server;
    proxy_http_version 1.1;
    # Do not pass either gateway credential to Argo or accept forwarded headers.
    proxy_pass_request_headers off;
    proxy_set_header Host $http_x_govbiz_argo_host;
    proxy_set_header X-Forwarded-Host $http_x_govbiz_argo_host;
    proxy_set_header Connection "";
    proxy_set_header Accept $http_accept;
    proxy_set_header Accept-Language $http_accept_language;
    proxy_set_header Content-Type $http_content_type;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Origin $http_origin;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 3s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    proxy_next_upstream off;
    proxy_buffering off;
    proxy_cache off;
    proxy_hide_header Cache-Control;
    proxy_hide_header Expires;
}
