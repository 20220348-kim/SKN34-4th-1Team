# 로컬 통합 Compose용 파일입니다. .env.compose로 복사하고 --env-file .env.compose로 선택합니다.
# 기존 애플리케이션 .env를 덮어쓰지 않습니다. Ops 비밀값은 backend/ops-service/.env에서 관리합니다.
COMPOSE_PROJECT_NAME=govbiz-infra
GOVBIZ_APP_ENV_FILE=./.env
GOVBIZ_DJANGO_ENV_FILE=./backend/ops-service/.env

# GOVBIZ_APP_ENV_FILE의 파일에 CATALOG_INTERNAL_TOKEN을 설정하세요(32자 이상, 서버 전용).
# 루트 Compose는 Catalog 분리형이 기본입니다. 기존 Core 데이터는 docs/catalog-service-extraction.md를
# 먼저 읽고 대조·전환하세요. 이 파일이나 예제 파일에 실제 토큰을 커밋하지 않습니다.

# 기존 로컬 볼륨 재사용 시에만 아래 두 줄을 활성화합니다.
# Windows/Linux/macOS에서 같은 파일 구분자를 사용합니다.
# COMPOSE_PATH_SEPARATOR=|
# COMPOSE_FILE=compose.yaml|compose.existing-data.yaml
# Catalog 데이터 대조·전환 조건을 확인한 후에만 아래 값을 설정합니다.
# GOVBIZ_CATALOG_TRANSITION_REVIEWED=1

# 기본값과 다른 기존 볼륨 이름을 사용할 때만 설정합니다.
# GOVBIZ_EXISTING_MYSQL_VOLUME=govbiz_mysql-data
# GOVBIZ_EXISTING_DJANGO_MYSQL_VOLUME=govbiz4-django_mysql-data
