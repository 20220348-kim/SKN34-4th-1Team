<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ai.govbiz.core.account.repository.mapper.CompanyMapper">

    <resultMap id="companyDbRow"
               type="ai.govbiz.core.account.repository.mapper.CompanyDbRow">
        <id column="id" property="id" />
        <result column="account_id" property="accountId" />
        <result column="business_number" property="businessNumber" />
        <result column="company_name" property="companyName" />
        <result column="business_status" property="businessStatus" />
        <result column="business_status_code" property="businessStatusCode" />
        <result column="region" property="region" />
        <result column="industry" property="industry" />
        <result column="founded_year" property="foundedYear" />
        <result column="homepage_url" property="homepageUrl" />
        <result column="business_verified_at" property="businessVerifiedAt" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
    </resultMap>

    <sql id="companyColumns">
        company.id,
        company.account_id,
        company.business_number,
        company.company_name,
        company.business_status,
        company.business_status_code,
        company.region,
        company.industry,
        company.founded_year,
        company.homepage_url,
        company.business_verified_at,
        company.created_at,
        company.updated_at
    </sql>

    <insert id="insertCompany"
            parameterType="ai.govbiz.core.account.repository.mapper.CompanyDbRow"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO company (
            account_id,
            business_number,
            company_name,
            business_status,
            business_status_code,
            region,
            industry,
            founded_year,
            homepage_url,
            business_verified_at,
            created_at,
            updated_at
        ) VALUES (
            #{accountId},
            #{businessNumber},
            #{companyName},
            #{businessStatus},
            #{businessStatusCode},
            #{region},
            #{industry},
            #{foundedYear},
            #{homepageUrl},
            #{businessVerifiedAt},
            #{createdAt},
            #{updatedAt}
        )
    </insert>

    <select id="findCompanyByAccountId" resultMap="companyDbRow">
        SELECT
            <include refid="companyColumns" />
        FROM company
        WHERE company.account_id = #{accountId}
    </select>

    <update id="updateCompanyProfile">
        UPDATE company
        SET region = #{region},
            industry = #{industry},
            founded_year = #{foundedYear},
            homepage_url = #{homepageUrl},
            updated_at = #{updatedAt}
        WHERE account_id = #{accountId}
    </update>

    <delete id="deleteCompanyByAccountId">
        DELETE FROM company
        WHERE account_id = #{accountId}
    </delete>
</mapper>
