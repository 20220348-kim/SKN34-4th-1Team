{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "1s",
    "similarity": {"lexical_bm25": {"type": "BM25", "k1": 1.2, "b": 0.75, "discount_overlaps": true}},
    "analysis": {
      "tokenizer": {
        "korean_words": {
          "type": "nori_tokenizer",
          "decompound_mode": "discard",
          "user_dictionary_rules": [
            "횡성",
            "소상공인",
            "여행사",
            "여행업체",
            "현장애로 현장 애로",
            "대출이자 대출 이자",
            "중기부",
            "중진공",
            "소진공",
            "과기정통부",
            "코트라",
            "알앤디",
            "바우처",
            "바우쳐",
            "판로",
            "중소벤처기업부 중소 벤처 기업 부",
            "중소벤처기업진흥공단 중소 벤처 기업 진흥 공단",
            "소상공인시장진흥공단 소상공인 시장 진흥 공단",
            "과학기술정보통신부 과학 기술 정보 통신 부",
            "대한무역투자진흥공사 대한 무역 투자 진흥 공사",
            "연구개발 연구 개발",
            "정책자금 정책 자금"
          ]
        }
      },
      "filter": {
        "program_synonyms": {
          "type": "synonym_graph",
          "lenient": "false",
          "synonyms": [
            "여행사, 여행업체",
            "중기부 => 중기부, 중소벤처기업부",
            "중진공 => 중진공, 중소벤처기업진흥공단",
            "소진공 => 소진공, 소상공인시장진흥공단",
            "과기정통부 => 과기정통부, 과학기술정보통신부",
            "코트라, KOTRA => 코트라, KOTRA, 대한무역투자진흥공사",
            "알앤디, R&D, 연구개발",
            "융자, 정책자금",
            "바우처, 바우쳐"
          ]
        }
      },
      "analyzer": {
        "korean": {
          "type": "custom",
          "tokenizer": "korean_words",
          "filter": ["nori_part_of_speech", "nori_readingform", "lowercase"]
        },
        "korean_search": {
          "type": "custom",
          "tokenizer": "korean_words",
          "filter": ["nori_part_of_speech", "nori_readingform", "lowercase", "program_synonyms"]
        }
      }
    }
  },
  "mappings": {
    "_meta": {"govbizSchema": "support-program-lexical-v3"},
    "dynamic": "strict",
    "properties": {
      "id": {"type": "keyword"},
      "contentHash": {"type": "keyword", "index": false, "doc_values": false},
      "sortTimestamp": {"type": "keyword"},
      "text": {"type": "text", "analyzer": "korean", "search_analyzer": "korean_search", "similarity": "lexical_bm25"}
    }
  }
}
