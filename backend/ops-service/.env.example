# 로컬 개발 전용 예시입니다. 운영 환경에서는 별도 비밀값과 배포 설정이 필요합니다.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-this-before-any-deployment-2026
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# 호스트에서 uv run으로 실행할 때 사용하는 접속 정보입니다.
# Compose의 ops-service는 DB_HOST=ops-mysql, DB_PORT=3306으로 덮어씁니다.
# DB 이름/사용자는 compose.yaml 및 개발용 DB 초기화 SQL과 일치시킵니다.
DB_NAME=govbiz4
DB_USER=govbiz4
DB_PASSWORD=govbiz4-local-password
DB_HOST=127.0.0.1
DB_PORT=3308

MYSQL_ROOT_PASSWORD=govbiz4-local-root-password
API_PORT=8001
MYSQL_PORT=3308

# 이전 Django 화면 주소로 접근하면 이 React 웹 주소로 이동합니다.
OPS_WEB_URL=http://localhost:5173
# 호스트 실행 기준. Compose는 OPS_CORE_API_URL 또는 host.docker.internal:8080을 사용합니다.
CORE_API_URL=http://127.0.0.1:8080
# 프록시가 Host를 바꾸는 경우에만 실제 웹 Origin을 명시합니다. 와일드카드를 사용하지 않습니다.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ops.example.com

# 호스트에서 Django와 평가 실행기를 함께 실행할 때의 설정입니다.
PREFECT_API_URL=http://127.0.0.1:14200/api
PREFECT_UI_URL=http://localhost:14200
LANGFUSE_PROJECT_URL=http://localhost:13000/project/govbiz-evidence-development
# LLMOPS_RESULTS_DIR=/absolute/path/to/SKN34-4th-1Team/work/llmops-ops
