{
  "name": "govbiz-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.22.x"
  },
  "scripts": {
    "dev:ops": "python3 infrastructure/llmops/start_local_ops.py",
    "dev:web": "pnpm --filter govbiz-web dev",
    "dev:mobile": "pnpm --filter @govbiz/mobile start",
    "test": "pnpm --recursive --if-present test",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "build:web": "pnpm --filter govbiz-web build"
  }
}
