# Keep the root .gitignore rules: EAS gives this file precedence over .gitignore.
# Environment and secrets
.env
.env.*
!.env.example
!.env.compose.example
!infrastructure/.env.production.example
.vercel
infrastructure/certs

# Python
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.coverage
htmlcov
.venv
*.egg-info

# Node
node_modules
.pnpm-store
dist
coverage
*.tsbuildinfo
.vite

# Kotlin/JVM and Gradle
.gradle
.kotlin
build
out
backend/core-service/bin
backend/catalog-service/bin
*.class

# Runtime and local artifacts
/site-publish
.data
uploads
tmp
work
*.log

# IDE and OS
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
tools

# Only mobile/shared source and root workspace settings are needed for the APK.
# EAS does not read .git/info/exclude when copying the working directory.
# Bare directory names also exclude the directory entry before Windows fs.cp opens it.
.git
.worktrees
.agents
.codex
.aws
/.uv-cache*
/output
/.vscode
/backend
/infrastructure
/evaluation
/docs
/.github
/frontend/web

# Mobile generated files and credentials (nested .gitignore rules do not apply here).
/frontend/mobile/.expo
/frontend/mobile/android
/frontend/mobile/ios
/frontend/mobile/expo-env.d.ts
credentials.json
google-services.json
*firebase-adminsdk*.json
*.jks
*.keystore
*.apk
*.aab
