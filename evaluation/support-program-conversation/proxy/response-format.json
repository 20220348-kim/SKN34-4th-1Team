{
  "type": "json_schema",
  "name": "SupportProgramConversationOutput",
  "strict": true,
  "schema": {
    "$defs": {
      "ConversationUpdate": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "enum": [
              "QUERY",
              "REGION",
              "INDUSTRY",
              "ESTABLISHED_ON",
              "FOUNDED_YEAR",
              "SUPPORT_PURPOSE",
              "ACCEPTING_ONLY"
            ],
            "title": "Field",
            "type": "string"
          },
          "operation": {
            "enum": [
              "SET",
              "CLEAR"
            ],
            "title": "Operation",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "evidence": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Evidence",
            "type": "string"
          }
        },
        "required": [
          "field",
          "operation",
          "value",
          "evidence"
        ],
        "title": "ConversationUpdate",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "모델은 조건 변경과 안내 종류만 선택한다. 사용자에게 보낼 문장은 생성하지 않는다.",
    "properties": {
      "status": {
        "enum": [
          "READY",
          "CLARIFICATION_REQUIRED",
          "ANSWERED"
        ],
        "title": "Status",
        "type": "string"
      },
      "updates": {
        "items": {
          "$ref": "#/$defs/ConversationUpdate"
        },
        "maxItems": 7,
        "title": "Updates",
        "type": "array"
      },
      "answerKind": {
        "anyOf": [
          {
            "enum": [
              "RESULT_SUMMARY",
              "SEARCH_HELP",
              "OUT_OF_SCOPE",
              "CANCEL_GUIDANCE"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Answerkind"
      },
      "clarificationKind": {
        "anyOf": [
          {
            "enum": [
              "QUERY",
              "REGION",
              "INDUSTRY",
              "ESTABLISHMENT",
              "SUPPORT_PURPOSE",
              "ACCEPTING_ONLY",
              "CHANGE_TARGET"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Clarificationkind"
      }
    },
    "required": [
      "status",
      "updates",
      "answerKind",
      "clarificationKind"
    ],
    "title": "SupportProgramConversationOutput",
    "type": "object"
  }
}
