{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "-1",
    "similarity": {
      "lexical_bm25": {"type": "BM25", "k1": 1.2, "b": 0.75, "discount_overlaps": true}
    },
    "analysis": {
      "analyzer": {
        "korean": {"type": "nori", "decompound_mode": "mixed"}
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id": {"type": "keyword"},
      "contentHash": {"type": "keyword", "index": false, "doc_values": false},
      "sortTimestamp": {"type": "keyword"},
      "text": {
        "type": "text",
        "analyzer": "standard",
        "similarity": "lexical_bm25",
        "fields": {
          "nori": {"type": "text", "analyzer": "korean", "similarity": "lexical_bm25"}
        }
      }
    }
  }
}
